<resources>
    <!-- Base application theme. -->
    <style name="Base.Theme.PRM392_Project" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="materialButtonStyle">@style/MyButtonStyle</item>
        <item name="android:statusBarColor">@color/purple</item>
    </style>

    <style name="Theme.PRM392_Project" parent="Base.Theme.PRM392_Project" />

    <style name="CenterTitleStyle">
        <item name="android:textColor">#fff</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <style name="MyButtonStyle" parent="Widget.Material3.Button">
        <item name="android:backgroundTint">@color/purple</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="cornerRadius">8dp</item>
    </style>
</resources>